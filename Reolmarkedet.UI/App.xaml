<Application x:Class="Reolmarkedet.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Reolmarkedet.UI"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
         <!--Opretter forbindelse mellem View og ViewModel-->
        <DataTemplate DataType="{x:Type viewModels:HomeViewModel}">
            <local:MainWindow />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ShelfOverviewViewModel}">
            <local:MainWindow />
        </DataTemplate>
        <!--Tilføj lease, tenant ... når de bliver oprettet-->
    </Application.Resources>
</Application>
