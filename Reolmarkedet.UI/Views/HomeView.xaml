<UserControl x:Class="Reolmarkedet.UI.Views.HomeView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:local="clr-namespace:Reolmarkedet.UI.Views"
            xmlns:widgets="clr-namespace:Reolmarkedet.UI.Widgets"
            Background="#f1efe8"
            mc:Ignorable="d"
            d:DesignHeight="450" d:DesignWidth="800">
   
    <Grid>
        <!-- Rows-->
        <Grid.RowDefinitions>
            <!--Navigation bar (Row 0)-->
            <RowDefinition Height="Auto"/>
            <!--Statistics (Row 1)-->
            <RowDefinition Height="Auto"/>
            <!--Main content (Row 2)-->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
       
        <!--1. Navigation-->
        <widgets:NavigationBar Grid.Row="0"/>

        <!-- 2. Statistics -->
        <UniformGrid Grid.Row="1" Columns="4"
              Margin="20,18,20,18">
            
            <StackPanel Margin="5">
                <TextBlock Text="Salg i dag"/>
                <TextBlock Text="1.240,00 kr."
               FontSize="24"
               FontWeight="Bold"/>
            </StackPanel>
            
            <StackPanel Margin="5">
                <TextBlock Text="Ledige reoler"/>
                <TextBlock Text="8 / 80"
                FontSize="24"
                FontWeight="Bold"/>
            </StackPanel>

            <StackPanel Margin="5">
                <TextBlock Text="Kommission (md.)"/>
                <TextBlock Text="4.381,74 kr."
               FontSize="24"
               FontWeight="Bold"/>
            </StackPanel>

            <StackPanel Margin="5">
                <TextBlock Text="Tid til opgørelse"/>
                <TextBlock Text="6 dage"
               FontSize="24"
               FontWeight="Bold"/>
            </StackPanel>
        </UniformGrid>
        
        <!-- 3. Main content -->
        <Grid Grid.Row="2" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Shelf overview -->
            <Border Grid.Column="0"
        Background="White"
        CornerRadius="10"
        Padding="15"
        Margin="0,0,10,0">
                <StackPanel>

                    <TextBlock Text="REOLOVERSIGT"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

                    <UniformGrid Columns="8">

                        <Button Content="1" Margin="4"
                        Background="#F8E5E3"/>
                        <Button Content="2" Margin="4"
                        Background="#F8E5E3"/>
                        <Button Content="3" Margin="4"
                        Background="#F8E5E3"/>
                        <Button Content="4" Margin="4"
                        Background="#F8E5E3"/>
                        <Button Content="5" Margin="4"
                        Background="#F8E5E3"/>
                        <Button Content="6" Margin="4"
                        Background="#F8E5E3"/>
                        <Button Content="7" Margin="4"
                        Background="#F8E5E3"/>
                        <Button Content="8" Margin="4"
                        Background="#E0ECD8"/>

                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Register sale -->
            <Border Grid.Column="1"
            Background="White"
            CornerRadius="10"
            Padding="15"
            Margin="10,0,0,0">

                <StackPanel>
                    <TextBlock Text="REGISTRÉR SALG"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

                    <TextBox Height="35"
                     Padding="8"
                     VerticalContentAlignment="Center"
                     ToolTip="Scan eller indtast stregkode"
                     Text=""/>

                    <TextBlock Text="Varer vises her"
                       Margin="0,15,0,15"/>

                    <Separator/>

                    <TextBlock Text="Total: 0,00 kr."
                       FontWeight="Bold"
                       FontSize="16"
                       Margin="0,15,0,15"/>

                    <Button Content="Bekræft salg"
                    Height="35"
                    FontWeight="Bold"/>
                </StackPanel>
                
            </Border>

        </Grid>

    </Grid>
</UserControl>
