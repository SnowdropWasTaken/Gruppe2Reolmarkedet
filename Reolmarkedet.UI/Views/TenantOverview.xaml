<Window x:Class="Reolmarkedet.UI.Views.TenantOverview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Reolmarkedet.UI.Views"
        mc:Ignorable="d"
        Title="TenantOverview" Height="450" Width="800" Background="#DFDDD7">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>

        <Label Content="LEJERE" 
               HorizontalAlignment="Left" 
               Margin="10,0,0,0" 
               Grid.Row="1" 
               Grid.Column="0" 
               VerticalAlignment="Center" 
               FontSize="16" 
               FontWeight="Bold" 
               Foreground="#FF383836"
               />

        <TextBox x:Name="SearchBox"
                 Margin="15,0,10,0"
                 Height="25"
                 Grid.Column="0"
                 Grid.Row="2"
                 TextChanged="SearchBox_TextChanged"
                 HorizontalAlignment="Stretch" 
                 VerticalAlignment="Center" SelectionTextBrush="White" Background="White" 
                 />

        <Rectangle HorizontalAlignment="Stretch" 
                   Margin="15,5,10,5" 
                   Grid.Row="3" 
                   Stroke="#FFABADB3"
                   VerticalAlignment="Stretch" 
                   RadiusX="10" 
                   RadiusY="10"
                   Fill="White"
                   />

        <Border
        CornerRadius="10"
        Padding="10"
        Grid.Column="0"
        Grid.Row="3"
        Margin="15,5,10,5" 
        >

            <ListBox BorderBrush="{x:Null}">
                <ListBoxItem>Item 1</ListBoxItem>
                <ListBoxItem>Item 2</ListBoxItem>
                <ListBoxItem>Item 3</ListBoxItem>
                <ListBoxItem>Item 4</ListBoxItem>
                <ListBoxItem>Item 5</ListBoxItem>
                <ListBoxItem>Item 6</ListBoxItem>
                <ListBoxItem>Item 7</ListBoxItem>
                <ListBoxItem>Item 8</ListBoxItem>
                <ListBoxItem>Item 9</ListBoxItem>
                <ListBoxItem>Item 10</ListBoxItem>
                <ListBoxItem>Item 11</ListBoxItem>
                <ListBoxItem>Item 12</ListBoxItem>
                <ListBoxItem>Item 13</ListBoxItem>
                <ListBoxItem>Item 14</ListBoxItem>
            </ListBox>

        </Border>
        <Button x:Name="___No_Name_" Grid.Column="1" Content="+ Ny lejer" HorizontalAlignment="Center" Grid.Row="2" VerticalAlignment="Center" Height="24" Width="247" Background="#FFE46034" BorderBrush="#FFAA4423" Foreground="White" FontWeight="Bold"/>

    </Grid>
</Window>

