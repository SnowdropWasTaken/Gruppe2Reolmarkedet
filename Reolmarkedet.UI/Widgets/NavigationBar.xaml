<UserControl x:Class="Reolmarkedet.UI.Widgets.NavigationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Reolmarkedet.UI.Widgets"
             Background="#4a1b0c"
             Height="50"
             mc:Ignorable="d"
             d:DesignHeight="50" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="5"/>
        </Grid.ColumnDefinitions>
        
        <!-- Left side -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Image Width="45" Stretch="Uniform" Source="../Assets/RM-logo.png"/>
            <TextBlock Foreground="#f1efe8" FontWeight="Bold" Padding="10">REOLMARKED</TextBlock>
        </StackPanel>
        
        <!-- Right side -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Padding="15, 0" Foreground="#D85A30" FontWeight="Bold" Background="#4a1b0c"
                    BorderThickness="0" Command="{Binding}">HJEM</Button>
            <Button Padding="15 ,0" Foreground="#f1efe8" FontWeight="Bold" Background="#4a1b0c"
                    BorderThickness="0" Command="{Binding}">OVERSIGT</Button>
            <Button Padding="15 ,0" Foreground="#f1efe8" FontWeight="Bold" Background="#4a1b0c"
                    BorderThickness="0" Command="{Binding}">SALG</Button>
            <Button Padding="15 ,0" Foreground="#f1efe8" FontWeight="Bold" Background="#4a1b0c"
                    BorderThickness="0" Command="{Binding}">LEJERE</Button>
            <Button Padding="15 ,0" Foreground="#f1efe8" FontWeight="Bold" Background="#4a1b0c"
                    BorderThickness="0" Command="{Binding}">AFREGNING</Button>
        </StackPanel>
    </Grid>
</UserControl>
